{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://worldrsi.local/contracts/world-state-v3.schema.json",
  "title": "WorldRSI world state v3",
  "description": "Editable scene hypothesis contract. Design fixtures, observations and native execution evidence remain distinct.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "document_role": {
      "enum": [
        "world_hypothesis",
        "design_fixture"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "coordinates": {
      "$ref": "#/$defs/coordinates"
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      },
      "minProperties": 1
    },
    "contexts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/context"
      },
      "minProperties": 0
    },
    "objects": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/object"
      },
      "minProperties": 1
    },
    "phenomena": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/phenomenon"
      },
      "minProperties": 0
    },
    "solvers": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/solver"
      },
      "minProperties": 0
    },
    "couplings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/coupling"
      },
      "minProperties": 0
    },
    "cameras": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/camera"
      },
      "minProperties": 0
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "editables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/editable"
      }
    },
    "runtime_bindings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/binding"
        },
        "minItems": 1
      },
      "minProperties": 0
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "document_role",
    "coordinates",
    "timeline",
    "sources",
    "objects"
  ],
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "timestamp_s": {
          "type": "number"
        },
        "region_xyxy": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "frame_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "value": {},
        "status": {
          "enum": [
            "observed",
            "hypothesis",
            "implementation_assumption",
            "unknown"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "value",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  null,
                  "unknown"
                ]
              }
            }
          }
        }
      ]
    },
    "quantity": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "required": [
            "unit"
          ]
        }
      ]
    },
    "parameter": {
      "type": "object",
      "properties": {
        "real": {
          "$ref": "#/$defs/quantity"
        },
        "simulation": {
          "$ref": "#/$defs/quantity"
        },
        "plausible_range": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "real",
        "simulation"
      ],
      "additionalProperties": false
    },
    "matrix3": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 3,
      "maxItems": 3
    },
    "matrix4": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      },
      "minItems": 4,
      "maxItems": 4
    },
    "intrinsics_claim": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "properties": {
            "value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/matrix3"
                },
                {
                  "enum": [
                    null,
                    "unknown"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "pose_claim": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "properties": {
            "value": {
              "anyOf": [
                {
                  "$ref": "#/$defs/matrix4"
                },
                {
                  "enum": [
                    null,
                    "unknown"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "text",
            "image",
            "video",
            "observation"
          ]
        },
        "availability": {
          "enum": [
            "available",
            "unavailable",
            "design_fixture"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "camera": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "camera": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "interval_s": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "continuity": {
                "enum": [
                  "continuous",
                  "cut",
                  "unknown"
                ]
              }
            },
            "required": [
              "id",
              "camera",
              "interval_s",
              "continuity"
            ],
            "additionalProperties": false
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "kind",
        "availability"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "world_frame": {
          "const": "world"
        },
        "handedness": {
          "const": "right"
        },
        "up_axis": {
          "enum": [
            "x",
            "y",
            "z"
          ]
        },
        "length_unit": {
          "const": "m"
        },
        "angle_unit": {
          "const": "rad"
        },
        "quaternion_order": {
          "enum": [
            "xyzw",
            "wxyz"
          ]
        },
        "metric_scale": {
          "$ref": "#/$defs/claim"
        }
      },
      "required": [
        "world_frame",
        "handedness",
        "up_axis",
        "length_unit",
        "angle_unit",
        "quaternion_order"
      ],
      "additionalProperties": false
    },
    "time_mapping": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_clock": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "world_clock": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_interval_s": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "world_interval_s": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "status": {
          "enum": [
            "observed",
            "hypothesis",
            "implementation_assumption",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "source_clock",
        "world_clock",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "observed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "evidence",
              "source_interval_s",
              "world_interval_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "hypothesis",
                  "implementation_assumption"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "source_interval_s",
              "world_interval_s"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unknown"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source_interval_s"
                  ]
                },
                {
                  "required": [
                    "world_interval_s"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "timeline": {
      "type": "object",
      "properties": {
        "unit": {
          "const": "s"
        },
        "clocks": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "description"
            ],
            "additionalProperties": false
          },
          "minProperties": 1,
          "required": [
            "world"
          ]
        },
        "source_mappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_mapping"
          }
        },
        "duration": {
          "$ref": "#/$defs/quantity"
        }
      },
      "required": [
        "unit",
        "clocks"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "embodiment": {
          "$ref": "#/$defs/claim"
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "capability_scope": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "fidelity": {
      "type": "object",
      "properties": {
        "model_class": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "reason": {
          "$ref": "#/$defs/claim"
        },
        "acceptance_cases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "model_class",
        "requirements",
        "reason"
      ],
      "additionalProperties": false
    },
    "relevance": {
      "type": "object",
      "properties": {
        "context": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "level": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "$ref": "#/$defs/claim"
        },
        "fidelity": {
          "$ref": "#/$defs/fidelity"
        }
      },
      "required": [
        "context",
        "level",
        "effects",
        "rationale"
      ],
      "additionalProperties": false
    },
    "representation": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "none",
            "primitive",
            "mesh",
            "procedural",
            "particles",
            "volume",
            "unknown"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "asset_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
          }
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "visual": {
          "$ref": "#/$defs/representation"
        },
        "collision": {
          "$ref": "#/$defs/representation"
        },
        "alignment": {
          "enum": [
            "shared_geometry",
            "separate_approximation",
            "unknown"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "visual",
        "collision",
        "alignment"
      ],
      "additionalProperties": false
    },
    "physics": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "motion": {
          "enum": [
            "static",
            "solver_driven",
            "controller_driven",
            "kinematic",
            "visual_only",
            "unknown"
          ]
        },
        "solver": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "collision": {
          "enum": [
            "enabled",
            "disabled",
            "unknown"
          ]
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          },
          "minProperties": 0
        },
        "controller": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "policy",
                "script",
                "target_tracking"
              ]
            },
            "entrypoint": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "actuation": {
              "enum": [
                "force",
                "torque",
                "joint_target",
                "kinematic_pose"
              ]
            }
          },
          "required": [
            "kind",
            "description",
            "actuation"
          ],
          "additionalProperties": false
        },
        "interaction_assumption": {
          "$ref": "#/$defs/claim"
        }
      },
      "required": [
        "model",
        "motion",
        "collision"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "motion": {
                "enum": [
                  "solver_driven",
                  "controller_driven"
                ]
              }
            },
            "required": [
              "motion"
            ]
          },
          "then": {
            "required": [
              "solver"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "motion": {
                "const": "controller_driven"
              }
            },
            "required": [
              "motion"
            ]
          },
          "then": {
            "required": [
              "controller"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "motion": {
                "const": "kinematic"
              }
            },
            "required": [
              "motion"
            ]
          },
          "then": {
            "required": [
              "interaction_assumption"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "motion": {
                "const": "visual_only"
              }
            },
            "required": [
              "motion"
            ]
          },
          "then": {
            "properties": {
              "collision": {
                "const": "disabled"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "solver"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "object": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relevance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relevance"
          }
        },
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "physics": {
          "$ref": "#/$defs/physics"
        },
        "pose": {
          "$ref": "#/$defs/pose_claim"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/claim"
          },
          "minProperties": 0
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "phenomenon": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "solver": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "coupling": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          },
          "minProperties": 0
        },
        "representation": {
          "$ref": "#/$defs/representation"
        },
        "relevance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relevance"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      },
      "required": [
        "description",
        "participants",
        "model"
      ],
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "not_run",
            "passed",
            "failed",
            "unsupported"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
